# Binance Web3 API — market data, quotes, swaps, dry-run/build Transaction
# API across xStocks, bStocks, and Ondo. Required for lib/data/quotes.ts
# and lib/execution/agentic-wallet.ts's dryRun(). Base URL confirmed
# against web3.binance.com/en/dev-docs: https://web3.binance.com/build
# — the "/build" segment is significant, it's part of the signed request
# path, not just a path prefix. Auth is real HMAC-SHA256 request signing
# (preHash = timestamp + method + requestPath + body, signed with the
# secret key, sent as X-OC-APIKEY / X-OC-TIMESTAMP / X-OC-SIGN headers),
# confirmed against actual docs — BINANCE_WEB3_API_SECRET is required,
# not optional.
BINANCE_WEB3_API_BASE_URL=
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Groq — isolated LLM layer for intent parsing and proposal generation.
# Not used until Phase 4 (lib/llm). Documented here so the full env
# contract is visible from Phase 0.
GROQ_API_KEY=

# BSC RPC — used by viem to broadcast the signed transaction in
# lib/execution/agentic-wallet.ts's send().
BSC_RPC_URL=

# The trading-capital wallet's own private key (PRD section 7's wallet-
# separation matrix): a plain, self-funded BSC EOA, funded per the
# hackathon rules — NOT Binance custody, NOT Agentic Wallet. send()
# signs the unsigned transaction from dryRun() locally with this key via
# viem and broadcasts it directly; no Binance execution endpoint is
# called. "Agentic Wallet" (the consumer product with QR/Binance-App
# sign-in) turned out to have no confirmed headless server-to-server
# REST API, so it was dropped from this codebase entirely — do not add
# AGENTIC_WALLET_API_KEY/BASE_URL back without a confirmed real API.
#
# This is far more sensitive than any other credential in this file: it
# directly controls funds, not just API access. Treat it accordingly —
# do not commit it, do not log it, and only fund the wallet it belongs
# to with what you're prepared to lose during the hackathon.
TRADING_WALLET_PRIVATE_KEY=
