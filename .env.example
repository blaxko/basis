# Binance Web3 API — market data, quotes, swaps, dry-run Transaction API
# across xStocks, bStocks, and Ondo. Required for lib/data/quotes.ts.
BINANCE_WEB3_API_BASE_URL=
BINANCE_WEB3_API_KEY=

# Groq — isolated LLM layer for intent parsing and proposal generation.
# Not used until Phase 4 (lib/llm). Documented here so the full env
# contract is visible from Phase 0.
GROQ_API_KEY=

# BSC RPC — used by viem for on-chain reads/writes in later phases
# (execution, guardrails). Not used yet in Phase 0/1.
BSC_RPC_URL=

# Agentic Wallet / Wallet Skills + BNB Agent Studio credentials.
# Used from Phase 3 (lib/execution/agentic-wallet.ts) for live send() only
# — dry-run goes through the Binance Web3 API Transaction API above.
AGENTIC_WALLET_API_BASE_URL=
AGENTIC_WALLET_API_KEY=
AGENT_STUDIO_API_KEY=
