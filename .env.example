# Binance Web3 API. Base URL: https://web3.binance.com/build — the
# "/build" segment is part of the signed request path, not just a prefix.
# HMAC-SHA256 signing (timestamp + method + path + query + body, signed
# with the secret, sent as X-OC-APIKEY / X-OC-TIMESTAMP / X-OC-SIGN).
# Used for the Trading API reference quote (every scheduler tick) and the
# Transaction API (simulate every transaction; MEV-protected broadcast).
BINANCE_WEB3_API_BASE_URL=
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Groq — intent parsing for /api/instruction.
GROQ_API_KEY=

# BSC RPC — pool reads, QuoterV2 simulation, gas estimates, and the
# nonce/gas/fee reads needed to sign. Never used to broadcast: every
# transaction goes out through Binance's MEV-protected broadcast.
BSC_RPC_URL=

# The trading wallet's private key: a plain, self-funded BSC EOA (not
# Binance custody, not Agentic Wallet). send() signs locally with it; the
# key never leaves the process. 64 hex characters, with or without 0x.
#
# It directly controls funds. Do not commit it, do not log it, and fund
# the wallet only with what you're prepared to lose. Never set it on a
# public deployment — use PUBLIC_READ_ONLY + TRADING_WALLET_ADDRESS there.
TRADING_WALLET_PRIVATE_KEY=

# Public deployment mode. "true" (or any value other than empty/"false")
# means: the key above is never read, the killswitch can't be set to
# live, /api/execution-test returns 403, and /api/instruction and
# /api/opportunities are rate-limited per IP. Leave unset locally.
PUBLIC_READ_ONLY=

# Read-only mode only: the trading wallet's PUBLIC address, used for
# simulations, allowance reads and quotes instead of deriving it from the
# key.
TRADING_WALLET_ADDRESS=
